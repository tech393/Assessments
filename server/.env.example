# Copy this file to .env and fill in your own DEV values.
# Never put production credentials here. .env is ignored by git; this file is not.

# Neon DEV database connection string (Neon dashboard -> Connect -> Prisma).
# - Use the DIRECT host (no "-pooler" in the name): Prisma migrations need a direct connection.
# - connect_timeout=15 gives a sleeping free-tier Neon database time to wake up (default is 5s).
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Port the Express API listens on. If you change it, also change the proxy in client/vite.config.js.
PORT=4000
